---
import Icono from '../ui/Icono.astro';
import Isla from './especificos/ConstructorPrompt.tsx';
import { cargarDatos } from '../../lib/interactivos';
interface Props { datos: string }
const d = cargarDatos<{ titulo: string; ejemplos: { nombre: string; bloques: Record<string, string> }[]; nota?: string }>(Astro.props.datos);
---
<section class="interactivo" aria-label={d.titulo}>
  <h3 class="interactivo-titulo"><Icono nombre="edit_note" tam={20} />{d.titulo}</h3>
  <Isla client:visible datos={d} />
</section>
