---
import Icono from '../ui/Icono.astro';
import Isla from './especificos/ModeloSintetico.tsx';
interface Props { modo: 'umbral' | 'sobreajuste' | 'calibracion' | 'grupos'; titulo: string; nota?: string }
const { modo, titulo, nota } = Astro.props;
---
<section class="interactivo" aria-label={titulo}>
  <h3 class="interactivo-titulo"><Icono nombre="monitoring" tam={20} />{titulo}</h3>
  <Isla client:visible datos={{ modo }} />
  {nota && <p class="interactivo-nota">{nota}</p>}
</section>
