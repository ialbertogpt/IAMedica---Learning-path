---
import Icono from '../ui/Icono.astro';
import Motor, { type DatosComparador } from './motores/Comparador.tsx';
import { cargarDatos } from '../../lib/interactivos';
interface Props { datos: string }
const d = cargarDatos<DatosComparador>(Astro.props.datos);
---
<section class="interactivo" aria-label={d.titulo}>
  <h3 class="interactivo-titulo"><Icono nombre="compare" tam={20} />{d.titulo}</h3>
  <Motor client:visible datos={d} />
</section>
