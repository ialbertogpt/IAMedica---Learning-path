---
// Término del glosario con definición desplegable: <T id="token">tokens</T>
import { getEntry } from 'astro:content';
interface Props { id: string }
const { id } = Astro.props;
const entrada = await getEntry('glosario', id);
if (!entrada) throw new Error(`[glosario] El término «${id}» no existe en src/data/glosario.json`);
const { termino, definicion, analogia } = entrada.data;
const uid = `def-${id}-${Math.random().toString(36).slice(2, 8)}`;
---
<span class="termino"><button type="button" aria-expanded="false" aria-controls={uid}><slot /></button><span id={uid} class="definicion" role="note" hidden data-pagefind-ignore><b>{termino}</b>{definicion}<span class="analogia">Analogía: {analogia}</span><a href={`/glosario/#${id}`}>Ver en el glosario</a></span></span>
