---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Icono from '../components/ui/Icono.astro';
import { subcapitulos, partes } from '../lib/curso';

const subs = await subcapitulos();
const color = (n: number) => `var(--${partes.find((p) => p.n === n)!.color})`;
---
<BaseLayout titulo="Fichas de bolsillo" seccion="fichas" descripcion="Fichas de bolsillo imprimibles de cada subcapítulo.">
  <div class="contenedor-lectura pt-7">
    <p class="eyebrow m-0">Fichas de bolsillo</p>
    <h1 class="mt-2">Lo esencial de cada subcapítulo, en una página</h1>
    <p class="tenue">Cada subcapítulo termina con una ficha que cabe en una hoja A4: el flujo de trabajo, dónde mirar, los errores típicos y lo que hay que verificar. Ábrela y pulsa <strong class="text-tinta font-medium">Imprimir ficha</strong>, o guárdala en PDF desde el diálogo de impresión.</p>
    <ol class="list-none m-0 mt-6 p-0 bg-superficie border border-borde rounded-xl overflow-hidden">
      {subs.map((s, i) => (
        <li class:list={['border-borde', i > 0 && 'border-t']} style={`--c:${color(s.parte)}`}>
          {s.construido ? (
            <a href={`${import.meta.env.BASE_URL}${s.slug}/#ficha`} class="flex items-center gap-3 min-h-[56px] px-4 no-underline text-tinta hover:bg-superficie-2">
              <span class="text-[var(--c)]"><Icono nombre={s.icono} tam={20} /></span>
              <span class="mono text-[13.5px] font-medium text-[var(--c)] w-9">{s.numero}</span>
              <span class="flex-1 min-w-0">{s.titulo}</span>
              <span class="inline-flex items-center gap-1.5 text-[14px] text-l1"><Icono nombre="description" tam={18} />Ver ficha</span>
            </a>
          ) : (
            <div class="flex items-center gap-3 min-h-[56px] px-4 text-tinta-2">
              <span class="text-tinta-3"><Icono nombre={s.icono} tam={20} /></span>
              <span class="mono text-[13.5px] font-medium text-[var(--c)] w-9">{s.numero}</span>
              <span class="flex-1 min-w-0">{s.titulo}</span>
              <span class="text-[13px] text-tinta-3 italic">En preparación</span>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
